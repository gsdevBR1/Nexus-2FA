{
  "manifest_version": 3,
  "name": "Nexus 2FA",
  "version": "1.0.0",
  "description": "Cofre 2FA local, criptografado com AES-256-GCM. Seus códigos, suas chaves, sem servidor.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Nexus 2FA",
    "default_popup": "dist/popup.html",
    "default_icon": {
      "16": "dist/icons/icon16.png",
      "32": "dist/icons/icon32.png",
      "48": "dist/icons/icon48.png",
      "128": "dist/icons/icon128.png"
    }
  },
  "icons": {
    "16": "dist/icons/icon16.png",
    "32": "dist/icons/icon32.png",
    "48": "dist/icons/icon48.png",
    "128": "dist/icons/icon128.png"
  },
  "permissions": ["storage", "clipboardWrite"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+N" },
      "description": "Abrir o cofre Nexus 2FA"
    }
  }
}
